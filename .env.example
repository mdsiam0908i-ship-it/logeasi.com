# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ROOT_ADMIN_EMAIL: Authorized email for permanent Root Super Admin initialization.
# Cannot be registered via public signup.
ROOT_ADMIN_EMAIL=""

# ROOT_ADMIN_SETUP_KEY: One-time server-side bootstrap secret for claiming Root Super Admin.
ROOT_ADMIN_SETUP_KEY=""

# Optional Root Admin bootstrap credentials (set via deployment Secrets, never commit real values)
PRIMARY_ADMIN_USERNAME="adm_46c6f85e"
PRIMARY_ADMIN_PASSWORD=""

# SESSION_SECRET: Secret used to sign HttpOnly authentication session tokens.
SESSION_SECRET=""

# DATA_ENCRYPTION_KEY: Optional AES-256-GCM key for sensitive server-side fields (e.g. 2FA secrets).
DATA_ENCRYPTION_KEY=""

# PAYMENT_WEBHOOK_SECRET: HMAC-SHA256 secret used to verify payment gateway server-to-server webhooks.
PAYMENT_WEBHOOK_SECRET=""

# PAYMENT_MODE: "sandbox" (default) or "live" (only after merchant approval & security testing).
PAYMENT_MODE="sandbox"

# Optional external notification provider webhooks (SMS / Email)
SMS_WEBHOOK_URL=""
EMAIL_WEBHOOK_URL=""
